{
  "name": "lipi-typing",
  "private": true,
  "version": "1.0.0",
  "description": "Lipi — A lightweight bilingual (Bangla & English) typing learning platform: Avro Phonetic, Bijoy, Bijoy Bayanno guide, interactive keyboards, lessons, practice & typing tests.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
